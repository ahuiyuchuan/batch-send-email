{
  "name": "batch-send-email",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "author": "ahui",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --tab-width 2 --write frontend index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --tab-width 2 --check frontend index.html package.json tsconfig.json vite.config.ts",
    "test:ui": "node frontend/tests/ui-check.mjs",
    "test:sort": "node --experimental-strip-types --test frontend/tests/view-sort.test.mjs",
    "test:preferences": "node --experimental-strip-types --test frontend/tests/preferences.test.mjs",
    "test:groups": "node --experimental-strip-types --test frontend/tests/group-selection.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "3.29.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "license": "GPL-3.0-only",
  "description": "QQ群成员整理与多账号邮件发送桌面工具",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahuiyuchuan/batch-send-email.git"
  },
  "homepage": "https://github.com/ahuiyuchuan/batch-send-email#readme",
  "bugs": {
    "url": "https://github.com/ahuiyuchuan/batch-send-email/issues"
  }
}
