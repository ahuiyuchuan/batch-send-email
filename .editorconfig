# Author: ahui. Use each language's normal indentation and UTF-8 source text.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,css,html,yml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

